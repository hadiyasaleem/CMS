<?xml version="1.0" encoding="utf-8"?>
<!--
    color/color_dept_card_stroke.xml
    Stroke ColorStateList for department course cards.
    Place in res/color/.

    selected  → accent_gold
    default   → outline_variant
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"
          android:color="@color/accent_gold" />
    <item android:color="@color/outline_variant" />
</selector>

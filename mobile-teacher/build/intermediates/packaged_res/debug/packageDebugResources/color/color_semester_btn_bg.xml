<?xml version="1.0" encoding="utf-8"?>
<!--
    color/color_semester_btn_bg.xml
    Background tint ColorStateList for MaterialButton semester selectors.
    Place in res/color/ (not res/drawable/).

    selected / activated  → tertiary_fixed  (faint gold)
    default               → transparent
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"
          android:color="@color/tertiary_fixed" />
    <item android:state_activated="true"
          android:color="@color/tertiary_fixed" />
    <item android:color="@android:color/transparent" />
</selector>

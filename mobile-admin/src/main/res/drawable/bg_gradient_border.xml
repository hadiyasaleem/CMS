<?xml version="1.0" encoding="utf-8"?>
<!--
    res/drawable/bg_gradient_border.xml
    Used as the outer wrapper background of the "Missing an entry?" CTA card.
    Creates a 2dp gradient border effect (primary → secondary left to right).

    Usage in layout:
        Outer LinearLayout  → android:background="@drawable/bg_gradient_border", android:padding="2dp"
        Inner LinearLayout  → android:background="@color/surface_container_lowest"
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/primary"
        android:endColor="@color/secondary" />

    <corners android:radius="4dp" />

</shape>

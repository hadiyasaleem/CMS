<?xml version="1.0" encoding="utf-8"?>
<!--
    item_absence_warning.xml
    One row in the "Absence Warning" card RecyclerView.
    Shows student name on the left and attendance % badge on the right.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Student name -->
    <TextView
        android:id="@+id/tv_warning_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Student Name"
        android:textSize="13sp"
        android:textColor="@color/on_surface"
        android:fontFamily="@font/public_sans"
        android:textStyle="bold" />

    <!-- Attendance % badge (red text, light red bg) -->
    <TextView
        android:id="@+id/tv_warning_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="70.0%"
        android:textSize="11sp"
        android:textColor="@color/secondary"
        android:fontFamily="@font/public_sans"
        android:textStyle="bold"
        android:background="@drawable/bg_warning_badge"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_timetable_management.xml
    TimeTableManagementActivity — Academic Schedule Grid
    Matches the HTML "Time Table Management" screen exactly:

    Structure:
      ┌──────────────────────────────────────────┐
      │  Top App Bar (back ← + brand + subtitle) │
      ├──────────────────────────────────────────┤
      │  NestedScrollView body:                  │
      │    - Hero header (college name + bar)    │
      │    - Description paragraph               │
      │    - Controls row (spinners + buttons)   │
      │    - HorizontalScrollView timetable grid │
      │        • Header row (Departments | slots)│
      │        • Department rows (programmatic)  │
      └──────────────────────────────────────────┘
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timetableRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ═══════════════════════════════════════════════════════════════
         TOP APP BAR
         ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBarTimetable"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:background="@color/surface_container_lowest"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <LinearLayout
            android:id="@+id/btnBackTimetable"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@color/primary" />
        </LinearLayout>

        <!-- Bank icon -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_account_balance"
            android:contentDescription="Logo"
            android:layout_marginEnd="8dp"
            app:tint="@color/primary" />

        <!-- Brand title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Academic Ledger"
            android:textSize="16sp"
            android:fontFamily="@font/newsreader_bold_italic"
            android:textColor="@color/primary" />

        <!-- Page subtitle (hidden on very small screens) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Table Management"
            android:textSize="11sp"
            android:fontFamily="@font/newsreader_italic"
            android:textColor="@color/on_surface_variant"
            android:layout_marginEnd="12dp" />

        <!-- Profile avatar -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="Admin"
            android:scaleType="centerCrop" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         SCROLLABLE BODY
         ═══════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBodyTimetable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBarTimetable"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ─────────────────────────────────────────────────────
                 HERO HEADER
                 ───────────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- College name headline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Govt Graduate College, Mandi Bahauddin"
                    android:textSize="26sp"
                    android:fontFamily="@font/newsreader_bold"
                    android:textColor="@color/primary"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginBottom="6dp" />

                <!-- Red accent bar -->
                <View
                    android:layout_width="48dp"
                    android:layout_height="3dp"
                    android:background="@color/secondary"
                    android:layout_marginBottom="12dp" />

                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Management portal for academic scheduling and departmental coordination. Ensure all lectures align with faculty availability and session constraints."
                    android:textSize="13sp"
                    android:fontFamily="@font/public_sans"
                    android:textColor="@color/on_surface_variant"
                    android:lineSpacingMultiplier="1.55" />

            </LinearLayout>

            <!-- ─────────────────────────────────────────────────────
                 CONTROLS ROW
                 ───────────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- SELECT SEMESTER -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT SEMESTER"
                    android:textSize="9sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/on_surface_variant"
                    android:textAllCaps="true"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_underline"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinnerSemester"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:paddingStart="2dp" />
                </LinearLayout>

                <!-- SELECT SESSION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT SESSION"
                    android:textSize="9sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/on_surface_variant"
                    android:textAllCaps="true"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_underline"
                    android:layout_marginBottom="20dp">

                    <Spinner
                        android:id="@+id/spinnerSession"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:paddingStart="2dp" />
                </LinearLayout>

                <!-- Buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <!-- Add New Slot button (outlined) -->
                    <LinearLayout
                        android:id="@+id/btnAddSlot"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_btn_outlined_primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_pending_actions"
                            android:contentDescription="Add slot"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add New Slot"
                            android:textSize="12sp"
                            android:fontFamily="@font/public_sans_semibold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <!-- Customize Grid button (filled) -->
                    <LinearLayout
                        android:id="@+id/btnCustomizeGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_more"
                            android:contentDescription="Customize"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/on_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customize Grid"
                            android:textSize="12sp"
                            android:fontFamily="@font/public_sans_semibold"
                            android:textColor="@color/on_primary" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- ─────────────────────────────────────────────────────
                 TIMETABLE GRID (horizontally scrollable)
                 ───────────────────────────────────────────────────── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/surface_container_low">

                    <!-- ─────────────────────────────────────────────
                         HEADER ROW: "Departments" | Slot 1..N
                         ─────────────────────────────────────────── -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@color/surface_container_low">

                        <!-- Corner: "Departments" -->
                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Departments"
                            android:textSize="13sp"
                            android:fontFamily="@font/newsreader_bold_italic"
                            android:textColor="@color/on_primary_container"
                            android:padding="16dp"
                            android:gravity="center_vertical" />

                        <!-- Slot 1 -->
                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SLOT 1"
                                android:textSize="8sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/on_surface_variant"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="08:00 – 08:45"
                                android:textSize="14sp"
                                android:fontFamily="@font/newsreader_bold"
                                android:textColor="@color/primary" />
                        </LinearLayout>

                        <!-- Slot 2 -->
                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SLOT 2"
                                android:textSize="8sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/on_surface_variant"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="08:45 – 09:30"
                                android:textSize="14sp"
                                android:fontFamily="@font/newsreader_bold"
                                android:textColor="@color/primary" />
                        </LinearLayout>

                        <!-- Slot 3 -->
                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SLOT 3"
                                android:textSize="8sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/on_surface_variant"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="09:30 – 10:15"
                                android:textSize="14sp"
                                android:fontFamily="@font/newsreader_bold"
                                android:textColor="@color/primary" />
                        </LinearLayout>

                        <!-- Slot 4 -->
                        <LinearLayout
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SLOT 4"
                                android:textSize="8sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/on_surface_variant"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10:15 – 11:00"
                                android:textSize="14sp"
                                android:fontFamily="@font/newsreader_bold"
                                android:textColor="@color/primary" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider below header -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/surface_container" />

                    <!-- ─────────────────────────────────────────────
                         DEPARTMENT ROWS (built programmatically)
                         containerDeptRows is a LinearLayout container
                         ─────────────────────────────────────────── -->
                    <LinearLayout
                        android:id="@+id/containerDeptRows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
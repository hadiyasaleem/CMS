<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER ROW -->
        <LinearLayout
            android:id="@+id/dept_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- Icon square -->
            <LinearLayout
                android:id="@+id/dept_icon_bg"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:background="@drawable/bg_dept_icon_active"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/dept_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_computer"
                    android:contentDescription="@null" />

            </LinearLayout>

            <!-- Name + faculty -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dept_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Department Name"
                    android:textSize="18sp"
                    android:textColor="@color/primary"
                    android:fontFamily="@font/newsreader_regular"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dept_faculty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Faculty Name"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:fontFamily="@font/public_sans"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Chevron -->
            <ImageView
                android:id="@+id/iv_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="@null"
                app:tint="@color/on_surface_variant" />

        </LinearLayout>

        <!-- EXPANDED SEMESTER SECTION -->
        <LinearLayout
            android:id="@+id/semester_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_variant"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT ACADEMIC SEMESTER"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:textColor="@color/on_surface_variant"
                android:fontFamily="@font/public_sans"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:id="@+id/semester_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
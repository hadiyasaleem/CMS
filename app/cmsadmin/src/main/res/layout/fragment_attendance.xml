<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_attendance.xml
    AttendanceFragment — Department Selection Screen (Image 1)

    Sections:
      1. Editorial header  (ACADEMIC REGISTRAR label + big title + description)
      2. RecyclerView      (expandable department cards, each with semester grid)
      3. Registry Audit banner  (dark navy with red CTA button)
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- ═══════════════════════════════════════
             § 1  EDITORIAL HEADER
             ═══════════════════════════════════════ -->

        <!-- Label: ACADEMIC REGISTRAR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACADEMIC REGISTRAR"
            android:textSize="10sp"
            android:letterSpacing="0.2"
            android:textColor="@color/secondary"
            android:fontFamily="@font/public_sans"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Giant headline (two-line, second italic + muted) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attendance"
            android:textSize="42sp"
            android:lineSpacingMultiplier="1.0"
            android:textColor="@color/primary"
            android:fontFamily="@font/newsreader_bold"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Management"
            android:textSize="36sp"
            android:textColor="@color/on_surface_variant"
            android:fontFamily="@font/newsreader_bold"
            android:textStyle="bold|italic"
            android:layout_marginBottom="16dp" />

        <!-- Description with left border accent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#33B22B1D"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select the constituent department to initialize the attendance registry for the current academic session."
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/on_surface_variant"
                android:fontFamily="@font/public_sans" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════
             § 2  DEPARTMENT LIST (RecyclerView)
             ═══════════════════════════════════════ -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_departments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />

        <!-- ═══════════════════════════════════════
             § 3  REGISTRY AUDIT BANNER
             ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            android:background="@color/primary_container"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registry Audit 2024"
                android:textSize="28sp"
                android:textColor="@color/on_primary"
                android:fontFamily="@font/newsreader_regular"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The ledger maintains a cryptographically verified record of all attendance entries to ensure institutional integrity."
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/on_primary_container"
                android:fontFamily="@font/public_sans"
                android:layout_marginBottom="20dp" />

            <!-- CTA Button -->
            <TextView
                android:id="@+id/btn_view_faculty_standards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIEW FACULTY STANDARDS"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textColor="@color/on_secondary"
                android:fontFamily="@font/public_sans"
                android:textStyle="bold"
                android:background="@color/secondary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
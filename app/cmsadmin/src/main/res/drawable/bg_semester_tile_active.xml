<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_semester_tile_active.xml
    Applied to the first semester tile (semester 01) to add the
    4dp crimson left border seen in the design.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container_low" />
        </shape>
    </item>
    <!-- 4dp left red border -->
    <item android:right="9999dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary" />
            <size android:width="4dp" />
        </shape>
    </item>
</layer-list>

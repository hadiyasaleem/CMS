<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_midterm_mark_entry.xml — CMS Teacher
    Matches the HTML "Imperial Chancery - Midterm Mark Entry" reference:
      § 1  Top app bar: avatar + "Imperial Chancery" + bell
      § 2  Page header: "Midterm Mark Entry" title + subtitle
      § 3  Subject spinner  |  Search field  (side by side on wider screens, stacked on small)
      § 4  Column header row: Student Identity | Roll Number | Midterm Score (Max 100)
      § 5  RecyclerView — student mark rows (MidtermMarkAdapter)
      § 6  Save Draft (outline) + Submit Marks (navy filled) buttons
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ═══════════════════════════════════════════════════════════
         SCROLLABLE BODY
         ═══════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="120dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── TOP APP BAR ───────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:paddingTop="48dp"
                android:paddingBottom="14dp"
                android:background="@color/surface_container_lowest"
                android:elevation="2dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_teacher_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_teacher_placeholder"
                    app:civ_border_width="1.5dp"
                    app:civ_border_color="@color/outline_variant"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Imperial Chancery"
                    android:textSize="20sp"
                    android:fontFamily="@font/newsreader_bold"
                    android:textColor="@color/primary" />

                <ImageButton
                    android:id="@+id/btn_notifications"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="Notifications"
                    app:tint="@color/primary" />

            </LinearLayout>

            <!-- ── PAGE HEADER ───────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="28dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Midterm Mark Entry"
                    android:textSize="26sp"
                    android:fontFamily="@font/newsreader_bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter academic performance records for the current term. Ensure all fields are validated before final submission."
                    android:textSize="13sp"
                    android:fontFamily="@font/public_sans"
                    android:textColor="@color/on_surface_variant"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="24dp" />

                <!-- ── SUBJECT SPINNER ────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUBJECT SELECTION"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="2dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinner_subject"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/public_sans"
                        android:textSize="14sp" />

                </androidx.cardview.widget.CardView>

                <!-- ── SEARCH FIELD ───────────────────────────────── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDENT REGISTRY SEARCH"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search_field"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        app:tint="@color/outline" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="Filter by name or roll number…"
                        android:textSize="13sp"
                        android:fontFamily="@font/public_sans"
                        android:textColor="@color/on_surface"
                        android:background="@android:color/transparent"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:paddingEnd="12dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── COLUMN HEADER ROW ─────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@color/primary_fixed">

                <!-- Student Identity -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.5"
                    android:text="STUDENT IDENTITY"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15" />

                <!-- Roll Number -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:layout_marginStart="8dp"
                    android:text="ROLL NUMBER"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15" />

                <!-- Score header -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.5"
                    android:layout_marginStart="8dp"
                    android:text="SCORE (MAX 100)"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:gravity="end" />

            </LinearLayout>

            <!-- ── STUDENT MARK ROWS ─────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface_container_lowest">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_marks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════════
         STICKY BOTTOM ACTION BAR
         Save Draft (outline) | Submit Marks (navy filled)
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="80dp"
        android:background="@color/surface"
        android:elevation="16dp"
        android:layout_gravity="bottom"
        app:layout_anchor="@id/main"
        app:layout_anchorGravity="bottom">

        <!-- Save Draft — outline style -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_draft"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="SAVE DRAFT"
            android:textSize="11sp"
            android:fontFamily="@font/public_sans_semibold"
            android:textColor="@color/primary"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"
            android:layout_marginEnd="12dp" />

        <!-- Submit Marks — navy filled -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_marks"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="SUBMIT MARKS"
            android:textSize="11sp"
            android:fontFamily="@font/public_sans_semibold"
            android:textColor="@color/on_primary"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_verified"
            app:iconTint="@color/on_primary"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            app:iconGravity="end" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
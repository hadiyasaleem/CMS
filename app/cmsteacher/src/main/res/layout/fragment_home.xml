<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_home.xml — CMS Teacher HomeFragment
    Matches the HTML "Imperial Chancery - Teacher Portal" dashboard:
      § 1  Fixed-style top bar: avatar circle + "Imperial Chancery" + 🔔
      § 2  Hero greeting: eyebrow + "Good Morning, Dr. Sterling." + navy rule
      § 3  Active Lecture card: live dot + subject + location/time + CTA button
      § 4  Faculty Dashboard: 2-col RecyclerView grid (ActionCardsAdapter)
      § 5  Academic Deadlines: vertical RecyclerView (DeadlinesAdapter)
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="88dp">

        <!-- ═══════════════════════════════════════════════════════════
             § 1  TOP APP BAR
             avatar | "Imperial Chancery" | notification bell
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="14dp"
            android:background="@color/surface_container_lowest"
            android:elevation="2dp">

            <!-- Teacher avatar (circular) -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_teacher_placeholder"
                app:civ_border_width="1.5dp"
                app:civ_border_color="@color/outline_variant"
                android:layout_marginEnd="12dp" />

            <!-- Brand title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Imperial Chancery"
                android:textSize="20sp"
                android:fontFamily="@font/newsreader_bold"
                android:textColor="@color/primary" />

            <!-- Notification bell -->
            <ImageButton
                android:id="@+id/btn_notifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_notifications"
                android:contentDescription="Notifications"
                app:tint="@color/primary" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 2  HERO GREETING
             eyebrow → giant serif name → navy rule
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <!-- Eyebrow: "Senior Faculty • Monday, Oct 24" -->
            <TextView
                android:id="@+id/tv_session_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENIOR FACULTY"
                android:textSize="11sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/on_tertiary_fixed_variant"
                android:textAllCaps="true"
                android:letterSpacing="0.18"
                android:layout_marginBottom="10dp" />

            <!-- Giant greeting -->
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good Morning,\nDr. Sterling."
                android:textSize="40sp"
                android:lineSpacingMultiplier="1.1"
                android:fontFamily="@font/newsreader_bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="18dp" />

            <!-- Navy horizontal rule (h-1 w-24 bg-scholar-navy) -->
            <View
                android:layout_width="96dp"
                android:layout_height="4dp"
                android:background="@color/primary" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 3  ACTIVE LECTURE CARD
             glass-panel p-6 border-l-4 border-l-scholar-navy
             live dot | subject | location + time | CTA button
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="28dp"
            android:background="@color/surface_container_lowest"
            android:elevation="2dp">

            <!-- Left navy border accent (4dp) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Left navy strip -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/primary" />

                <!-- Card content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Live dot + "Current Session" label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <View
                            android:id="@+id/live_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_live_dot"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tv_session_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURRENT SESSION"
                            android:textSize="10sp"
                            android:fontFamily="@font/public_sans_semibold"
                            android:textColor="@color/on_surface_variant"
                            android:textAllCaps="true"
                            android:letterSpacing="0.2" />

                    </LinearLayout>

                    <!-- Subject name -->
                    <TextView
                        android:id="@+id/tv_current_subject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Advanced Architecture"
                        android:textSize="22sp"
                        android:fontFamily="@font/newsreader_bold"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="6dp" />

                    <!-- Location row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_location"
                            android:contentDescription="@null"
                            android:layout_marginEnd="4dp"
                            app:tint="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/tv_current_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lecture Hall B"
                            android:textSize="13sp"
                            android:fontFamily="@font/public_sans"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginEnd="16dp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_schedule"
                            android:contentDescription="@null"
                            android:layout_marginEnd="4dp"
                            app:tint="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/tv_current_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:00 AM – 11:30 AM"
                            android:textSize="13sp"
                            android:fontFamily="@font/public_sans"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <!-- Mark Attendance CTA button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mark_attendance_cta"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="MARK ATTENDANCE"
                        android:textSize="11sp"
                        android:fontFamily="@font/public_sans_semibold"
                        android:textColor="@color/on_primary"
                        android:letterSpacing="0.12"
                        android:layout_marginTop="16dp"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_attendance"
                        app:iconTint="@color/on_primary"
                        app:iconSize="18dp"
                        app:iconPadding="8dp" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 4  FACULTY DASHBOARD — 2-column grid
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Section header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FACULTY DASHBOARD"
                    android:textSize="11sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.18" />

            </LinearLayout>

            <!-- 1dp divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline_variant"
                android:alpha="0.4"
                android:layout_marginBottom="12dp" />

            <!-- 2-col action cards grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_action_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 5  ACADEMIC DEADLINES — vertical list
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Section header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACADEMIC DEADLINES"
                android:textSize="11sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/primary"
                android:textAllCaps="true"
                android:letterSpacing="0.18"
                android:paddingBottom="12dp" />

            <!-- 1dp divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline_variant"
                android:alpha="0.4"
                android:layout_marginBottom="12dp" />

            <!-- Deadlines RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_deadlines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
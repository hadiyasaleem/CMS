<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_exams.xml — CMS Teacher ExamsFragment
    Matches the HTML "Exams: Selection" reference:
      § 1  Header: "Exam Management" + gold divider + "Mark Entry Parameters" eyebrow
      § 2  Academic Year spinner
      § 3  Semester spinner
      § 4  Department row (Computer Science & Engineering, selected)
      § 5  Assessment type: Midterm card | Sessional card (toggle)
      § 6  "Proceed to Subject List" full-width navy button + disclaimer
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="100dp">

        <!-- ═══════════════════════════════════════════════════════════
             § 1  HEADER
             "Exam Management" (large serif) + gold rule + eyebrow
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exam Management"
                android:textSize="36sp"
                android:fontFamily="@font/newsreader_bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Gold rule -->
            <View
                android:layout_width="64dp"
                android:layout_height="2dp"
                android:background="@color/tertiary_fixed_dim"
                android:layout_marginBottom="12dp" />

            <!-- "Mark Entry Parameters" eyebrow -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MARK ENTRY PARAMETERS"
                android:textSize="10sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/on_surface_variant"
                android:textAllCaps="true"
                android:letterSpacing="0.2" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 2 + § 3  YEAR & SEMESTER SPINNERS (2-column row)
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Academic Year -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACADEMIC YEAR"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="4dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp">

                    <Spinner
                        android:id="@+id/spinner_year"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/public_sans"
                        android:textSize="14sp" />

                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Semester -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEMESTER"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="4dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp">

                    <Spinner
                        android:id="@+id/spinner_semester"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/public_sans"
                        android:textSize="14sp" />

                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 4  DEPARTMENT SELECTION
             Static card — CS&E shown as selected
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEPARTMENT"
                android:textSize="10sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/primary"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Selected department row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <!-- Icon badge -->
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_action_card_icon"
                            android:layout_marginEnd="14dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_account_balance"
                                android:contentDescription="@null"
                                app:tint="@color/primary" />

                        </FrameLayout>

                        <!-- Department info -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Computer Science &amp; Engineering"
                                android:textSize="16sp"
                                android:fontFamily="@font/newsreader_bold"
                                android:textColor="@color/primary"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FACULTY OF TECHNOLOGY"
                                android:textSize="10sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/on_surface_variant"
                                android:textAllCaps="true"
                                android:letterSpacing="0.12" />

                        </LinearLayout>

                        <!-- Check icon (selected state) -->
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radio_checked"
                            android:contentDescription="@null" />

                    </LinearLayout>

                    <!-- "Click to change" hint row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="10dp"
                        android:background="@color/surface_container_low">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Click to change department…"
                            android:textSize="12sp"
                            android:fontFamily="@font/public_sans"
                            android:textStyle="italic"
                            android:textColor="@color/on_surface_variant" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:contentDescription="@null"
                            app:tint="@color/on_surface_variant" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 5  ASSESSMENT TYPE — two-card toggle
             Midterm Exams | Sessional Marks
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSESSMENT TYPE"
                android:textSize="10sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/primary"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- ── MIDTERM CARD ─────────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_midterm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Radio indicator (top-right) — ImageView -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:id="@+id/iv_midterm_radio"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_radio_checked"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <!-- Icon badge -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle_navy"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_exams"
                                android:contentDescription="@null"
                                app:tint="@color/on_primary" />

                        </FrameLayout>

                        <!-- Title -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Midterm Exams"
                            android:textSize="18sp"
                            android:fontFamily="@font/newsreader_bold"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="6dp" />

                        <!-- Description -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Formal semester-mid evaluations and centralized testing."
                            android:textSize="12sp"
                            android:fontFamily="@font/public_sans"
                            android:textColor="@color/on_surface_variant"
                            android:lineSpacingMultiplier="1.4" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── SESSIONAL CARD ───────────────────────────────── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_sessional"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Radio indicator (top-right) — ImageView -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end"
                            android:layout_marginBottom="12dp">

                            <ImageView
                                android:id="@+id/iv_sessional_radio"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_radio_unchecked"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <!-- Icon badge -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_chip_rounded"
                            android:layout_marginBottom="14dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_grades"
                                android:contentDescription="@null"
                                app:tint="@color/on_surface_variant" />

                        </FrameLayout>

                        <!-- Title -->
                        <TextView
                            android:id="@+id/tv_sessional_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sessional Marks"
                            android:textSize="18sp"
                            android:fontFamily="@font/newsreader_bold"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginBottom="6dp" />

                        <!-- Description -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Internal assessments, attendance, and laboratory work."
                            android:textSize="12sp"
                            android:fontFamily="@font/public_sans"
                            android:textColor="@color/on_surface_variant"
                            android:lineSpacingMultiplier="1.4"
                            android:alpha="0.7" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 6  PROCEED BUTTON + DISCLAIMER
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_proceed"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="PROCEED TO SUBJECT LIST"
                android:textSize="13sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/on_primary"
                android:letterSpacing="0.12"
                android:stateListAnimator="@null"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconTint="@color/on_primary"
                app:iconGravity="end"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ensure all previous marks are synchronized before proceeding"
                android:textSize="10sp"
                android:fontFamily="@font/public_sans"
                android:textColor="@color/on_surface_variant"
                android:gravity="center"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:alpha="0.6"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
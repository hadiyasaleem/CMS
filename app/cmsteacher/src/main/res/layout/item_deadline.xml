<?xml version="1.0" encoding="utf-8"?>
<!--
    item_deadline.xml
    A single "Academic Deadlines" row in HomeFragment's RecyclerView.
    Matches HTML: glass-panel p-5 rounded-xl flex gap-4 border-l-2 border-l-{color}
    Structure:
      [left colour strip] | [icon] | [title / subtitle / due-label]
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="10dp"
    android:background="@color/surface_container_lowest"
    android:elevation="1dp">

    <!-- Left colour border strip (3dp wide, full height) -->
    <View
        android:id="@+id/view_left_border"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/secondary" />

    <!-- Leading icon -->
    <ImageView
        android:id="@+id/iv_deadline_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="14dp"
        android:src="@drawable/ic_high_priority"
        android:contentDescription="@null"
         />

    <!-- Text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingEnd="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_deadline_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deadline Title"
            android:textSize="14sp"
            android:fontFamily="@font/newsreader_bold"
            android:textColor="@color/primary"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="3dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_deadline_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batch 2024 • Architecture"
            android:textSize="12sp"
            android:fontFamily="@font/public_sans"
            android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="6dp" />

        <!-- Due label (coloured by urgency) -->
        <TextView
            android:id="@+id/tv_deadline_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DUE IN 4 HOURS"
            android:textSize="10sp"
            android:fontFamily="@font/public_sans_semibold"
            android:textColor="@color/secondary"
            android:textAllCaps="true"
            android:letterSpacing="0.12" />

    </LinearLayout>
</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_mark_attendance.xml
    ══════════════════════════════════════════════════════════════════════
    Layout for MarkAttendanceActivity — "Mark Attendance" screen.
    Mirrors HTML reference 2 (Mark Attendance - Imperial Chancery).

    Structure:
      CoordinatorLayout
        ├─ MaterialToolbar          (back arrow + "MARK ATTENDANCE" title)
        ├─ NestedScrollView
        │    ├─ Session Header card
        │    ├─ Search bar
        │    ├─ RecyclerView  (student rows — item_student_attendance.xml)
        │    └─ Summary strip (Present / Absent / Leave)
        └─ Sticky submit button (above BottomNav)

    Colors / tokens used:
      scholar_navy   #002147
      accent_gold    #B18000
      secondary_red  #B22B1D
      surface_glass  rgba(249,249,249,0.7)
      surface_container  #EEEEEE
    ══════════════════════════════════════════════════════════════════════
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- ══════════════════════════════════════════════════════════════
         TOP APP BAR
         ══════════════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_glass"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingHorizontal="8dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/scholar_navy"
            app:title="MARK ATTENDANCE"
            app:titleTextAppearance="@style/TextAppearance.CmsTeacher.ToolbarTitle"
            app:titleTextColor="@color/scholar_navy"
            app:menu="@menu/menu_mark_attendance"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ══════════════════════════════════════════════════════════════
         SCROLLABLE CONTENT
         ══════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <!-- ─────────────────────────────────────────────────────
                 § 1  SESSION HEADER CARD
                 ───────────────────────────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_glass"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Eyebrow label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT MODULE"
                        android:fontFamily="@font/public_sans_semibold"
                        android:textSize="10sp"
                        android:textColor="@color/accent_gold"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp"/>

                    <!-- Course name -->
                    <TextView
                        android:id="@+id/tv_course_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Advanced Architecture III"
                        android:fontFamily="@font/newsreader_bold"
                        android:textSize="20sp"
                        android:textColor="@color/scholar_navy"
                        android:layout_marginBottom="8dp"/>

                    <!-- Date + time row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_calendar_today"
                            android:layout_marginEnd="4dp"
                            app:tint="@color/on_surface_variant"/>

                        <TextView
                            android:id="@+id/tv_session_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oct 24, 2024"
                            android:fontFamily="@font/public_sans"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface_variant"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="14dp"
                            android:layout_marginHorizontal="10dp"
                            android:background="@color/outline_variant"/>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_schedule"
                            android:layout_marginEnd="4dp"
                            app:tint="@color/on_surface_variant"/>

                        <TextView
                            android:id="@+id/tv_session_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Morning Session  (09:00 – 11:30)"
                            android:fontFamily="@font/public_sans"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface_variant"/>
                    </LinearLayout>

                    <!-- Capacity + Mark All button row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SESSION CAPACITY"
                                android:fontFamily="@font/public_sans"
                                android:textSize="9sp"
                                android:textColor="@color/on_surface_variant"
                                android:letterSpacing="0.05"/>

                            <TextView
                                android:id="@+id/tv_capacity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42 Students"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textSize="15sp"
                                android:textColor="@color/scholar_navy"/>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_mark_all_present"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Mark All Present"
                            android:fontFamily="@font/public_sans_semibold"
                            android:textSize="11sp"
                            android:letterSpacing="0.1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="@color/scholar_navy"
                            app:cornerRadius="12dp"/>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─────────────────────────────────────────────────────
                 § 2  SEARCH BAR
                 ───────────────────────────────────────────────────── -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/on_surface_variant"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/outline_variant"
                app:hintTextColor="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Search by name or roll number…"
                    android:fontFamily="@font/public_sans"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:background="@color/surface_glass"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- ─────────────────────────────────────────────────────
                 § 3  STUDENT LIST
                 Item layout: item_student_attendance.xml
                 ───────────────────────────────────────────────────── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_students"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:layout_marginBottom="20dp"
                tools:listitem="@layout/item_student_attendance"
                tools:itemCount="5"
                xmlns:tools="http://schemas.android.com/tools"/>

            <!-- ─────────────────────────────────────────────────────
                 § 4  SUMMARY STRIP
                 ───────────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Present -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/surface_glass"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="14dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start"
                            android:layout_marginBottom="8dp"
                            android:background="@color/color_success"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRESENT"
                            android:fontFamily="@font/public_sans"
                            android:textSize="9sp"
                            android:textColor="@color/on_surface_variant"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_count_present"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:fontFamily="@font/newsreader_bold"
                            android:textSize="22sp"
                            android:textColor="@color/scholar_navy"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Absent -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="@color/surface_glass"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="14dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start"
                            android:layout_marginBottom="8dp"
                            android:background="@color/secondary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ABSENT"
                            android:fontFamily="@font/public_sans"
                            android:textSize="9sp"
                            android:textColor="@color/on_surface_variant"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_count_absent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:fontFamily="@font/newsreader_bold"
                            android:textSize="22sp"
                            android:textColor="@color/scholar_navy"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Leave -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_glass"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="14dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start"
                            android:layout_marginBottom="8dp"
                            android:background="@color/accent_gold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LEAVE"
                            android:fontFamily="@font/public_sans"
                            android:textSize="9sp"
                            android:textColor="@color/on_surface_variant"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/tv_count_leave"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:fontFamily="@font/newsreader_bold"
                            android:textSize="22sp"
                            android:textColor="@color/scholar_navy"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════════════════════════
         § 5  STICKY SUBMIT BUTTON
         Floats above the BottomNav (marginBottom ≈ BottomNav height)
         ══════════════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit_attendance"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="72dp"
        android:text="SUBMIT ATTENDANCE REGISTRY"
        android:fontFamily="@font/public_sans_semibold"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:letterSpacing="0.18"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/scholar_navy"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_how_to_reg"
        app:iconTint="@android:color/white"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:elevation="8dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
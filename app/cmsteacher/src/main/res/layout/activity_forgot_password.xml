<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/activity_forgot_password.xml — CMS Teacher
    Matches the HTML "Credential Recovery" screen:
    ✔ Top app bar: school icon + "CMS TEACHER" + back arrow
    ✔ Lock-reset icon in a circular badge (centered)
    ✔ "Credential Recovery" headline + description
    ✔ Institutional Email underline input
    ✔ "Send Reset Link" full-width navy button
    ✔ Inline error TextView (hidden by default)
    ✔ Inline success TextView (hidden by default)
    ✔ Loading ProgressBar (hidden by default)
    ✔ "Return to Login" arrow link at bottom
    ✔ Footer: security protocol note
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- ══════════════════════════════════════════════════════════════════
         TOP APP BAR
         back arrow | school icon | "CMS TEACHER"
         ══════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="14dp"
        android:background="@color/white"
        android:elevation="2dp">

        <!-- Back arrow -->
        <ImageView
            android:id="@+id/btnReturnToLogin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Return to login"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/primary" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_account_balance"
            android:contentDescription="College logo"
            android:layout_marginEnd="10dp"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CMS TEACHER"
            android:textSize="15sp"
            android:fontFamily="@font/newsreader_bold"
            android:textColor="@color/primary"
            android:textAllCaps="true"
            android:letterSpacing="0.18" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════════
         SCROLLABLE BODY
         ══════════════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── RECOVERY CARD ─────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="32dp">

                    <!-- ── LOCK ICON BADGE (centered) ─────────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginBottom="28dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_circle_navy"
                            android:elevation="4dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lock_reset"
                                android:contentDescription="Credential recovery"
                                app:tint="@color/on_primary" />

                        </FrameLayout>
                    </LinearLayout>

                    <!-- ── HEADLINE ───────────────────────────────────── -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Credential Recovery"
                        android:textSize="28sp"
                        android:fontFamily="@font/newsreader_bold"
                        android:textColor="@color/primary"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />

                    <!-- ── DESCRIPTION ────────────────────────────────── -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enter your institutional email address to receive a secure password reset link."
                        android:textSize="14sp"
                        android:fontFamily="@font/public_sans"
                        android:textColor="@color/on_surface_variant"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.55"
                        android:layout_marginBottom="36dp" />

                    <!-- ── INSTITUTIONAL EMAIL LABEL ──────────────────── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INSTITUTIONAL EMAIL"
                        android:textSize="10sp"
                        android:fontFamily="@font/public_sans_semibold"
                        android:textColor="@color/on_surface_variant"
                        android:textAllCaps="true"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="4dp" />

                    <!-- ── EMAIL INPUT ────────────────────────────────── -->
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="faculty.name@ggcmbd.edu.pk"
                        android:inputType="textEmailAddress"
                        android:textSize="15sp"
                        android:fontFamily="@font/public_sans"
                        android:textColor="@color/on_surface"
                        android:background="@drawable/bg_input_underline"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:layout_marginBottom="8dp" />

                    <!-- ── ERROR MESSAGE (hidden by default) ──────────── -->
                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:fontFamily="@font/public_sans"
                        android:textColor="@color/error"
                        android:lineSpacingMultiplier="1.4"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp" />

                    <!-- ── SUCCESS MESSAGE (hidden by default) ────────── -->
                    <TextView
                        android:id="@+id/tvSuccess"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:fontFamily="@font/public_sans"
                        android:textColor="#1A5F1A"
                        android:lineSpacingMultiplier="1.4"
                        android:background="@drawable/bg_badge_submitted"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp" />

                    <!-- ── SEND RESET LINK BUTTON ─────────────────────── -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendReset"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="SEND RESET LINK"
                        android:textSize="13sp"
                        android:fontFamily="@font/public_sans_semibold"
                        android:textColor="@color/on_primary"
                        android:letterSpacing="0.18"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="4dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconTint="@color/on_primary"
                        app:iconGravity="end"
                        app:iconPadding="10dp"
                        app:iconSize="18dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp" />

                    <!-- ── LOADING INDICATOR (hidden by default) ────────── -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone"
                        android:layout_marginTop="8dp" />

                    <!-- ── DIVIDER ─────────────────────────────────────── -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/surface_container_high"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="20dp" />

                    <!-- ── RETURN TO LOGIN LINK ───────────────────────── -->
                    <LinearLayout
                        android:id="@+id/btnReturnToLoginBottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_arrow_back"
                            android:contentDescription="Return to login"
                            android:layout_marginEnd="8dp"
                            app:tint="@color/on_surface_variant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RETURN TO LOGIN"
                            android:textSize="11sp"
                            android:fontFamily="@font/public_sans_semibold"
                            android:textColor="@color/on_surface_variant"
                            android:textAllCaps="true"
                            android:letterSpacing="0.15" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── FOOTER ─────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp"
                android:background="@color/surface_container_low">

                <!-- Shield + security label -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_verified_user"
                        android:contentDescription="Security"
                        android:layout_marginEnd="6dp"
                        android:alpha="0.6"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INSTITUTIONAL SECURITY PROTOCOL"
                        android:textSize="9sp"
                        android:fontFamily="@font/public_sans_semibold"
                        android:textColor="@color/on_surface_variant"
                        android:textAllCaps="true"
                        android:letterSpacing="0.18"
                        android:alpha="0.6" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© 2024 Institutional Registry. Authorized Personnel Only."
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans"
                    android:textColor="@color/on_surface_variant"
                    android:gravity="center"
                    android:alpha="0.6" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_sessional_mark_entry.xml — CMS Teacher
    Matches the HTML "Sessional Mark Entry" screen:
      § 1  Top app bar: avatar + "Imperial Chancery" + bell
      § 2  Page header: "Academic Session 2024" eyebrow + "Sessional Mark Entry" title
      § 3  Subject spinner
      § 4  Search bar + Sort toggle (Roll No / Name)
      § 5  Table header row (Student | Attendance | Assignments | Quizzes | Total)
      § 6  RecyclerView — student mark rows (SessionalMarkAdapter)
      § 7  Sticky bottom actions: Save Draft | Submit Marks
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ═══════════════════════════════════════════════════════════
         MAIN SCROLLABLE CONTENT
         ═══════════════════════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="120dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── TOP APP BAR ───────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/top_app_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:paddingTop="48dp"
                android:paddingBottom="14dp"
                android:background="@color/surface_container_lowest"
                android:elevation="2dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_teacher_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_teacher_placeholder"
                    app:civ_border_width="1.5dp"
                    app:civ_border_color="@color/outline_variant"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Imperial Chancery"
                    android:textSize="20sp"
                    android:fontFamily="@font/newsreader_bold"
                    android:textColor="@color/primary" />

                <ImageButton
                    android:id="@+id/btn_notifications"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notifications"
                    android:contentDescription="Notifications"
                    app:tint="@color/primary" />

            </LinearLayout>

            <!-- ── PAGE HEADER + SUBJECT SPINNER ─────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp">

                <!-- Eyebrow -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACADEMIC SESSION 2024"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/on_tertiary_fixed_variant"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="4dp" />

                <!-- Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sessional Mark Entry"
                    android:textSize="26sp"
                    android:fontFamily="@font/newsreader_bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="20dp" />

                <!-- Subject label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT SUBJECT"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/on_surface_variant"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="6dp" />

                <!-- Subject spinner -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="20dp">

                    <Spinner
                        android:id="@+id/spinner_subject"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/public_sans"
                        android:textSize="14sp" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ── SEARCH + SORT ROW ─────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- Search field -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_search_field"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        app:tint="@color/outline" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Search by name or roll number…"
                        android:textSize="13sp"
                        android:fontFamily="@font/public_sans"
                        android:textColor="@color/on_surface"
                        android:background="@android:color/transparent"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:paddingEnd="12dp" />

                </LinearLayout>

                <!-- Sort buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sort_roll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="ROLL NO"
                        android:textSize="9sp"
                        android:fontFamily="@font/public_sans_semibold"
                        android:textColor="@color/on_primary"
                        android:letterSpacing="0.08"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="4dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sort_name"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="NAME"
                        android:textSize="9sp"
                        android:fontFamily="@font/public_sans_semibold"
                        android:textColor="@color/on_surface_variant"
                        android:letterSpacing="0.08"
                        android:stateListAnimator="@null"
                        app:backgroundTint="@color/surface_container_high"
                        app:cornerRadius="4dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── TABLE HEADER ROW ──────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:background="@color/primary_fixed">

                <!-- Student column header -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:text="STUDENT"
                    android:textSize="10sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.15" />

                <!-- Attendance header -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="ATTEND\n(10)"
                    android:textSize="9sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:gravity="center"
                    android:letterSpacing="0.1" />

                <!-- Assignments header -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="ASSIGN\n(20)"
                    android:textSize="9sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:gravity="center"
                    android:letterSpacing="0.1" />

                <!-- Quizzes header -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="QUIZ\n(20)"
                    android:textSize="9sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:gravity="center"
                    android:letterSpacing="0.1" />

                <!-- Total header -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="TOTAL\n(50)"
                    android:textSize="9sp"
                    android:fontFamily="@font/public_sans_semibold"
                    android:textColor="@color/primary"
                    android:textAllCaps="true"
                    android:gravity="end"
                    android:letterSpacing="0.1" />

            </LinearLayout>

            <!-- ── STUDENT MARK ROWS ─────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface_container_lowest">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_marks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════════
         STICKY BOTTOM ACTION BAR
         Save Draft | Submit Marks
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="80dp"
        android:background="@color/surface"
        android:elevation="16dp"
        app:layout_anchor="@id/main"
        app:layout_anchorGravity="bottom"
        android:layout_gravity="bottom">

        <!-- Save Draft button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_draft"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="SAVE DRAFT"
            android:textSize="11sp"
            android:fontFamily="@font/public_sans_semibold"
            android:textColor="@color/primary"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/surface_container_highest"
            app:cornerRadius="12dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_save"
            app:iconTint="@color/primary"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            android:layout_marginEnd="12dp" />

        <!-- Submit Marks button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_marks"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="SUBMIT MARKS"
            android:textSize="11sp"
            android:fontFamily="@font/public_sans_semibold"
            android:textColor="@color/on_primary"
            android:letterSpacing="0.1"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_send"
            app:iconTint="@color/on_primary"
            app:iconSize="18dp"
            app:iconPadding="8dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
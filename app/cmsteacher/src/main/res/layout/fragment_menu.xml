<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_menu.xml — CMS Teacher MenuFragment
    Matches the HTML "Faculty Portal - CMS Teacher Hub" reference:
      § 1  Top app bar: school icon badge + "Faculty Portal" + bell + avatar
      § 2  Administrative Actions — "Approve Student Requests" action card
      § 3  Institutional Resources — list of 4 navigable rows
      § 4  Support & Account — Help & Support / Account Settings card
      § 5  Sign Out button + footer version label
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".fragments.MenuFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="88dp">

        <!-- ═══════════════════════════════════════════════════════════
             § 1  TOP APP BAR
             rotated navy badge + "Faculty Portal" | bell | avatar circle
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="14dp"
            android:background="@color/surface_container_lowest"
            android:elevation="2dp">

            <!-- Rotated navy badge with account_balance icon -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_navy"
                android:rotation="12"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_account_balance"
                    android:contentDescription="@null"
                    app:tint="@color/on_primary" />

            </FrameLayout>

            <!-- Title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Faculty Portal"
                android:textSize="20sp"
                android:fontFamily="@font/newsreader_bold"
                android:textColor="@color/primary" />

            <!-- Notification bell -->
            <ImageButton
                android:id="@+id/btn_notifications"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_notifications"
                android:contentDescription="Notifications"
                android:layout_marginEnd="4dp"
                app:tint="@color/primary" />

            <!-- Avatar -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_avatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_teacher_placeholder"
                app:civ_border_width="1dp"
                app:civ_border_color="@color/outline_variant" />

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 2  ADMINISTRATIVE ACTIONS
             "Approve Student Requests" action-required card
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <!-- Section eyebrow -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADMINISTRATIVE ACTIONS"
                android:textSize="11sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/on_surface_variant"
                android:textAllCaps="true"
                android:letterSpacing="0.18"
                android:layout_marginBottom="14dp" />

            <!-- Action card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_approve_requests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Top row: text block + icon badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Text block -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- "Action Required" pill -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTION REQUIRED"
                                android:textSize="9sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/on_secondary"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"
                                android:background="@color/secondary"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:layout_marginBottom="10dp" />

                            <!-- Headline -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Approve Student Requests"
                                android:textSize="20sp"
                                android:fontFamily="@font/newsreader_bold"
                                android:textColor="@color/primary"
                                android:layout_marginBottom="6dp" />

                            <!-- Description -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="There are 3 pending requests for course overrides and transcript revisions awaiting your signature."
                                android:textSize="13sp"
                                android:fontFamily="@font/public_sans"
                                android:textColor="@color/on_surface_variant"
                                android:lineSpacingMultiplier="1.4" />

                        </LinearLayout>

                        <!-- Icon badge -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_badge_secondary_tint"
                            android:layout_marginStart="12dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_exams"
                                android:contentDescription="@null"
                                app:tint="@color/secondary" />

                        </FrameLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline_variant"
                        android:alpha="0.25"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="14dp" />

                    <!-- Bottom row: avatar stack + Review Now button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Overlapping avatar stack -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_weight="1">

                            <View
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_avatar_stack_1" />

                            <View
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="20dp"
                                android:background="@drawable/bg_avatar_stack_2" />

                            <View
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="40dp"
                                android:background="@drawable/bg_avatar_stack_3" />

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="60dp"
                                android:background="@drawable/bg_avatar_stack_plus"
                                android:gravity="center"
                                android:text="+1"
                                android:textSize="9sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/primary" />

                        </FrameLayout>

                        <!-- Review Now button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_review_now"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="Review Now"
                            android:textSize="13sp"
                            android:fontFamily="@font/public_sans_semibold"
                            android:textColor="@color/on_primary"
                            android:letterSpacing="0.02"
                            android:stateListAnimator="@null"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_arrow_forward"
                            app:iconTint="@color/on_primary"
                            app:iconGravity="end"
                            app:iconPadding="8dp"
                            app:iconSize="16dp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 3  INSTITUTIONAL RESOURCES
             Faculty Directory · Departmental News · Resource Library · College Handbook
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INSTITUTIONAL RESOURCES"
                android:textSize="11sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/on_surface_variant"
                android:textAllCaps="true"
                android:letterSpacing="0.18"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Faculty Directory -->
                <include layout="@layout/item_menu_resource_row"
                    android:id="@+id/row_faculty_directory" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- Departmental News -->
                <include layout="@layout/item_menu_resource_row"
                    android:id="@+id/row_departmental_news" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- Resource Library -->
                <include layout="@layout/item_menu_resource_row"
                    android:id="@+id/row_resource_library" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- College Handbook -->
                <include layout="@layout/item_menu_resource_row"
                    android:id="@+id/row_college_handbook" />

            </LinearLayout>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 4  SUPPORT & ACCOUNT
             Help & Support · Account Settings (grouped card)
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUPPORT &amp; ACCOUNT"
                android:textSize="11sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/on_surface_variant"
                android:textAllCaps="true"
                android:letterSpacing="0.18"
                android:layout_marginBottom="14dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_container"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Help & Support -->
                    <LinearLayout
                        android:id="@+id/row_help_support"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_help"
                            android:contentDescription="@null"
                            android:layout_marginEnd="16dp"
                            app:tint="@color/on_surface_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Help &amp; Support"
                                android:textSize="14sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/primary"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contact IT or view tutorials"
                                android:textSize="11sp"
                                android:fontFamily="@font/public_sans"
                                android:textColor="@color/on_surface_variant" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_open_in_new"
                            android:contentDescription="@null"
                            app:tint="@color/outline_variant" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline_variant"
                        android:alpha="0.2" />

                    <!-- Account Settings -->
                    <LinearLayout
                        android:id="@+id/row_account_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="@null"
                            android:layout_marginEnd="16dp"
                            app:tint="@color/on_surface_variant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Account Settings"
                                android:textSize="14sp"
                                android:fontFamily="@font/public_sans_semibold"
                                android:textColor="@color/primary"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Security, passwords, and profile"
                                android:textSize="11sp"
                                android:fontFamily="@font/public_sans"
                                android:textColor="@color/on_surface_variant" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_settings_suggest"
                            android:contentDescription="@null"
                            app:tint="@color/outline_variant" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════════════════════
             § 5  SIGN OUT + FOOTER
             ═══════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- Sign Out button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_out"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sign Out from Portal"
                android:textSize="14sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/error"
                android:letterSpacing="0.02"
                android:stateListAnimator="@null"
                app:backgroundTint="@color/transparent"
                app:strokeColor="@color/error"
                app:strokeWidth="1.5dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/error"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                android:layout_marginBottom="20dp" />

            <!-- Footer version label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INSTITUTIONAL CMS V4.8.2 • SECURE SESSION ACTIVE"
                android:textSize="9sp"
                android:fontFamily="@font/public_sans_semibold"
                android:textColor="@color/on_surface_variant"
                android:textAllCaps="true"
                android:letterSpacing="0.18"
                android:gravity="center"
                android:alpha="0.4" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
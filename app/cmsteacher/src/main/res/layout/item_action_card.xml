<?xml version="1.0" encoding="utf-8"?>
<!--
    item_action_card.xml
    A single faculty dashboard action card used in the 2-column RecyclerView grid.
    Matches HTML: glass-panel p-6 rounded-xl card-hover — icon badge + title + subtitle
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_container_lowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <!-- Icon badge (navy tinted square) -->
        <LinearLayout
            android:id="@+id/icon_badge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:gravity="center"
            android:background="@drawable/bg_action_card_icon"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/iv_card_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_attendance"
                android:contentDescription="@null"
                app:tint="@color/primary" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Card Title"
            android:textSize="18sp"
            android:fontFamily="@font/newsreader_bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_card_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Card subtitle text"
            android:textSize="12sp"
            android:fontFamily="@font/public_sans"
            android:textColor="@color/on_surface_variant" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
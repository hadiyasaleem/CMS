<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_mark_input.xml
    Normal state background for sessional mark EditText fields.
    Matches HTML: bg-surface-container border border-outline-variant/30 rounded
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container" />
    <stroke
        android:width="1dp"
        android:color="#4DC4C6CF" />
    <corners android:radius="4dp" />
</shape>
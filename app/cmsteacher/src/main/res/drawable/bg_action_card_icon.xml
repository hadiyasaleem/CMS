<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_action_card_icon.xml
    Light navy-tinted rounded square for the icon badge
    inside each faculty dashboard action card.
    Matches HTML: bg-primary-fixed rounded-lg (#D6E3FF)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/primary_fixed" />
    <corners android:radius="8dp" />
</shape>
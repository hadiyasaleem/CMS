<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_search_field.xml
    Rounded rectangle background for the search bar in SessionalMarkEntryActivity.
    Matches HTML: bg-surface-container-lowest border border-outline-variant rounded-lg
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container_lowest" />
    <stroke
        android:width="1dp"
        android:color="@color/outline_variant" />
    <corners android:radius="8dp" />
</shape>
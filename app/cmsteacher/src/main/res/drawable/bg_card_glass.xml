<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_card_glass.xml
    Fallback shape drawable for glass-panel cards when MaterialCardView
    is not used (e.g. plain FrameLayout needs a bg).
    Backdrop blur is handled by the view hierarchy / window; this only
    provides the fill + border.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke
        android:width="1dp"
        android:color="@color/outline_variant" />
    <corners android:radius="12dp" />
</shape>

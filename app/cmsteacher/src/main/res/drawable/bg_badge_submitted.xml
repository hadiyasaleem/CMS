<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_badge_submitted.xml
    Green pill badge background — used for the success confirmation TextView
    in ForgotPasswordActivity. Also used for "Submitted" status labels.
    Matches HTML: bg-[#e6f4e6] text-[#1a5f1a]
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#E6F4E6" />
    <corners android:radius="2dp" />

</shape>
<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_timeline_dot_outline.xml
    Grey outline oval — used for optional/dimmed timeline events (Evening Reception).
    Matches HTML: bg-outline-variant rounded-full border-4 border-paper-white
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- White ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_container_lowest" />
        </shape>
    </item>

    <!-- Grey fill inset -->
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/outline_variant" />
        </shape>
    </item>

</layer-list>

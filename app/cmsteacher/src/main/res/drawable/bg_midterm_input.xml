<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_midterm_input.xml
    Matches the HTML midterm input style:
      bg-surface-container border-b-2 border-outline-variant rounded-t-sm
    Bottom border only — top corners slightly rounded, no side/top borders.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Filled background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container" />
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Bottom border line (2dp) -->
    <item
        android:top="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/outline_variant" />
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="4dp" />
        </shape>
    </item>

</layer-list>

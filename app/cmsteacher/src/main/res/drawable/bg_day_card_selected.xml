<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_day_card_selected.xml
    Active day card in the Schedule week strip.
    White background + 2dp gold bottom border + subtle elevation via layer-list.
    Matches HTML: glass-panel border-b-2 border-accent-gold
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- White fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container_lowest" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Gold bottom border only (clip top/left/right borders off-screen) -->
    <item
        android:top="-3dp"
        android:left="-3dp"
        android:right="-3dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/tertiary_fixed_dim" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</layer-list>
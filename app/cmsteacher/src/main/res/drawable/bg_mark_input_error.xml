<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_mark_input_error.xml
    Error state background for sessional mark EditText fields — value exceeds max.
    Matches HTML: border-error text-error
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/error_container" />
    <stroke
        android:width="1.5dp"
        android:color="@color/error" />
    <corners android:radius="4dp" />
</shape>
<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_chip_surface.xml
    Used by the "Last Sync" and "Status" info chips inside the
    Faculty Integrity Standards card, and any other surface-level chips.
    Matches HTML: bg surface_container_low (#F3F3F3), 1dp outline_variant border,
    8dp corner radius.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_container_low" />
    <stroke
        android:width="1dp"
        android:color="@color/outline_variant" />
    <corners android:radius="8dp" />
</shape>

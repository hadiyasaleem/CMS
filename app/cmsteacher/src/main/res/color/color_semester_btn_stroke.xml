<?xml version="1.0" encoding="utf-8"?>
<!--
    color/color_semester_btn_stroke.xml
    Stroke tint ColorStateList for MaterialButton semester selectors.
    Place in res/color/.

    selected / activated  → tertiary_fixed_dim  (vivid gold, 2dp)
    default               → outline_variant      (grey, 1dp)
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"
          android:color="@color/tertiary_fixed_dim" />
    <item android:state_activated="true"
          android:color="@color/tertiary_fixed_dim" />
    <item android:color="@color/outline_variant" />
</selector>
